{
  "name": "desafio-tecnico-accenture",
  "version": "1.0.0",
  "description": "Repositório destinado ao desafio técnico da Accenture Brasil",
  "main": "index.js",
  "scripts": {
    "test": "cypress run",
    "test:open": "cypress open",
    "test:api": "cypress run --spec \"cypress/e2e/features/etapa-1-api/**/*.feature\"",
    "test:frontend": "cypress run --spec \"cypress/e2e/features/etapa-2-frontend/**/*.feature\"",
    "report": "node generate-report.mjs",
    "test:api:report": "npm run test:api && npm run report",
    "test:frontend:report": "npm run test:frontend && npm run report",
    "test:all:report": "npm run test && npm run report"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victorcnascimento/desafio-tecnico-accenture.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/victorcnascimento/desafio-tecnico-accenture/issues"
  },
  "homepage": "https://github.com/victorcnascimento/desafio-tecnico-accenture#readme",
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^28.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@faker-js/faker": "^10.6.0",
    "cypress": "^16.1.1",
    "esbuild": "^0.28.2",
    "multiple-cucumber-html-reporter": "^4.4.2",
    "typescript": "^7.0.2"
  }
}
